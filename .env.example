# The plugin does not load this file automatically. Export these variables to
# the Codex process, or configure the Atbash SDK user config instead.
ATBASH_AGENT_KEY=
ATBASH_ORG_NAME=

# Optional SDK overrides
ATBASH_ENDPOINT=
ATBASH_BLOCKCHAIN_RID=
ATBASH_PROVIDER=
ATBASH_PROVIDER_MODEL=

# Optional plugin timeout: integer milliseconds from 1000 through 30000.
ATBASH_CODEX_TIMEOUT_MS=30000
