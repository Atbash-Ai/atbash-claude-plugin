# The plugin does not load this file automatically. Export these variables to
# the Claude Code process, or configure the Atbash SDK user config instead.
# Configure the private key only; the SDK derives its public key locally.
ATBASH_AGENT_KEY=replace-with-agent-private-key
ATBASH_ORG_NAME=replace-with-exact-organization-name

# Optional SDK overrides
ATBASH_ENDPOINT=
ATBASH_BLOCKCHAIN_RID=
ATBASH_PROVIDER=
ATBASH_PROVIDER_MODEL=

# Optional plugin timeout: integer milliseconds from 1000 through 30000.
# ATBASH_CODEX_TIMEOUT_MS is still honored as a legacy fallback.
ATBASH_HOOK_TIMEOUT_MS=30000
