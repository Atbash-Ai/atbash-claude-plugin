{
  "name": "@atbash/claude-plugin",
  "version": "0.5.0",
  "license": "MIT",
  "private": true,
  "description": "Atbash safety enforcement and secure local onboarding for Claude Code.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./runtime/index.cjs",
  "files": [
    ".claude-plugin",
    "hooks",
    "runtime",
    "skills"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "build:marketplace": "node build-marketplace.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-tests/tests/*.test.js",
    "status": "node dist/status.cjs"
  },
  "dependencies": {
    "@atbash/sdk": "0.10.10-dev.0"
  }
}
