{
  "description": "Atbash evaluates supported tool calls before execution.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/runtime/pre-tool-use.cjs\"",
            "timeout": 35
          }
        ]
      }
    ]
  }
}
